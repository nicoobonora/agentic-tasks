# Export these in the server environment; uvicorn does not load this file automatically.
ACS_DB=data/acs.sqlite
ACS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Required for mode=model; never committed with a real value.
OPENAI_API_KEY=
# Explicit model supporting Responses API Structured Outputs.
ACS_MODEL=
ACS_MAX_ROUNDS=3
# Speed vs depth (defaults favour speed). Empty effort = parameter not sent.
ACS_REASONING_EFFORT=low
ACS_MAX_OUTPUT_TOKENS=3000
ACS_CONTEXT_MESSAGES=12
ACS_EVIDENCE_CHARS=1200
ACS_PROVIDER_REQUESTS=5
# Frontend: rounds per cycle requested by the UI (1 = fastest).
VITE_MAX_ROUNDS=1
