    "id": {
      "title": "Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "cycle": {
      "title": "Cycle",
      "type": "integer"
    },
    "role": {
      "title": "Role",
      "type": "string"
    },
    "turn_token": {
      "title": "Turn Token",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ToolRequest"
