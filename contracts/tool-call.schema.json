    "normalized_parameters": {
      "additionalProperties": true,
      "title": "Normalized Parameters",
      "type": "object"
    },
    "cache_key": {
      "title": "Cache Key",
      "type": "string"
    },
    "source_fingerprint": {
      "default": "",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "method_version": {
      "default": "1",
      "title": "Method Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
