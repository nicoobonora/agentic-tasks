          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "name",
        "arguments"
      ],
      "title": "ToolRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
