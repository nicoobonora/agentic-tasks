  "components": {
    "schemas": {
      "AnalysisBundle": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Input Sha256"
          },
          "input_start": {
            "type": "string",
            "format": "date-time",
            "title": "Input Start"
          },
          "input_end": {
            "type": "string",
            "format": "date-time",
            "title": "Input End"
          },
          "method_version": {
            "type": "string",
            "title": "Method Version"
          },
          "cleaning_parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Cleaning Parameters"
          },
          "reconstruction_parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Reconstruction Parameters"
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "covariates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Covariates"
          },
          "backtest": {
            "additionalProperties": true,
            "type": "object",
            "title": "Backtest"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/ControlTable"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Tables"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "generated_at",
          "input_sha256",
          "input_start",
          "input_end",
          "method_version",
          "cleaning_parameters",
          "reconstruction_parameters",
          "model_name",
          "model_version",
          "covariates",
          "backtest",
          "tables"
        ],
        "title": "AnalysisBundle"
      },
      "Attachment": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40000
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Attachment"
      },
      "Catalog": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "origin": {
            "type": "string",
            "const": "scenario_assumption",
            "title": "Origin",
            "default": "scenario_assumption"
          },
          "policy": {
            "additionalProperties": true,
            "type": "object",
            "title": "Policy"
          },
          "site_assessments": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Site Assessments"
          },
          "products": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Products"
          },
          "offers": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Offers"
          },
          "work_schedule": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Work Schedule"
          },
          "contract_terms": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Contract Terms"
          },
          "economic_parameters": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Economic Parameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "policy",
          "site_assessments",
          "products",
          "offers",
          "work_schedule",
          "contract_terms",
          "economic_parameters"
        ],
        "title": "Catalog"
      },
      "Cell": {
        "properties": {
          "p": {
            "type": "number",
            "enum": [
              1.0,
              0.5
            ],
            "title": "P"
          },
          "quantile": {
            "type": "string",
            "enum": [
              "p50",
              "high"
            ],
            "title": "Quantile"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "demand_per_hour": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Demand Per Hour"
          },
          "mean_occupancy_hours": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Occupancy Hours"
          },
          "access_current": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Current"
          },
          "access_plus_2": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Plus 2"
          },
          "access_plus_4": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Plus 4"
          },
          "access_restored": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Restored"
          },
          "required_total_capacity": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Total Capacity"
          },
          "minimum_increment": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  0,
                  2,
                  4
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Minimum Increment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "p",
          "quantile",
          "status"
        ],
        "title": "Cell"
      },
      "ControlTable": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "site_name": {
            "type": "string",
            "enum": [
              "BZ_C_RISPARMIO_01",
              "BZ_PIAVE_01",
              "RENON_01"
            ],
            "title": "Site Name"
          },
          "group": {
            "type": "string",
            "const": "AC_22",
            "title": "Group",
            "default": "AC_22"
          },
          "origin": {
            "type": "string",
            "const": "derived",
            "title": "Origin",
            "default": "derived"
          },
          "method": {
            "type": "string",
            "enum": [
              "timestral",
              "seasonal_naive",
              "seasonal_naive_trend",
              "reserve"
            ],
            "title": "Method"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "title": "Period Start"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "title": "Period End"
          },
          "measure_nature": {
            "type": "string",
            "title": "Measure Nature"
          },
          "high_quantile_definition": {
            "type": "string",
            "enum": [
              "daily_p90_curve",
              "historical_percentile_90"
            ],
            "title": "High Quantile Definition"
          },
          "operational_capacity": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Operational Capacity"
          },
          "registry_capacity": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Registry Capacity"
          },
          "restored_capacity": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Restored Capacity"
          },
          "service_threshold": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Service Threshold"
          },
          "cells": {
            "items": {
              "$ref": "#/components/schemas/Cell"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Cells"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
