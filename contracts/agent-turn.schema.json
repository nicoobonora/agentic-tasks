      "title": "Applicability",
      "type": "string"
    },
    "kind": {
      "enum": [
        "proposal",
        "review",
        "objection",
        "revision",
        "not_applicable"
      ],
      "title": "Kind",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "objections": {
      "items": {
        "$ref": "#/$defs/ObjectionDraft"
      },
      "title": "Objections",
      "type": "array"
    },
    "resolutions": {
      "items": {
        "$ref": "#/$defs/Resolution"
      },
      "title": "Resolutions",
      "type": "array"
    },
    "draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/Draft"
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuestionDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "needs_revision": {
      "title": "Needs Revision",
      "type": "boolean"
    }
  },
  "required": [
    "applicability",
    "kind",
    "text",
    "explanation",
    "evidence_ids",
    "claims",
    "objections",
    "resolutions",
    "draft",
    "question",
    "needs_revision"
  ],
  "title": "AgentTurn",
  "type": "object"
}
